{
  "name": "gala-ph-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Philippine Barkada Travel & Itemized Consumption Ledger Platform",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs = require('fs'); if (fs.existsSync('apps/api/prisma/schema.prisma')) { require('child_process').execSync('npm run prisma:generate --workspace=apps/api', { stdio: 'inherit' }); }\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:shared && npm run test:api && npm run test:mobile && npm run test:web",
    "test:shared": "npm run test --workspace=packages/shared",
    "test:api": "npm run test --workspace=apps/api",
    "test:mobile": "npm run test --workspace=apps/mobile",
    "test:web": "npm run test --workspace=apps/web",
    "db:migrate:test": "npm run db:migrate:test --workspace=apps/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
